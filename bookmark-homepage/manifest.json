{
  "manifest_version": 3,
  "name": "书签主页",
  "version": "1.0.0",
  "description": "把收藏夹变成漂亮的主页:文件夹卡片、分类侧栏、收藏搜索。打开新标签页即可使用。",
  "permissions": ["bookmarks", "favicon", "storage"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
